<UserControl x:Class="McLauncher.App.ContentDownloadsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:McLauncher.App" local:ScrollWheelRouting.IsEnabled="True" FontFamily="{StaticResource BodyFont}" FontSize="14" Foreground="{StaticResource TextBrush}">
 <UserControl.Resources>
  <Style x:Key="FileRow" TargetType="ListBoxItem" BasedOn="{StaticResource BaseListBoxItem}">
   <Setter Property="Padding" Value="0"/>
  </Style>
  <DataTemplate x:Key="DownloadableFile">
   <Button Click="DownloadFile_Click" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="16,12" Foreground="{StaticResource TextBrush}" AutomationProperties.Name="{Binding DisplayName, StringFormat=下载或从官网获取 {0}}" ToolTip="点击下载此版本；无法直接下载的文件将打开官网。">
    <StackPanel>
     <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding FileName}" Style="{StaticResource Caption}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
     <TextBlock Foreground="{StaticResource AccentBrush}" Margin="0,10,0,0" FontSize="12" FontWeight="SemiBold">
      <TextBlock.Style><Style TargetType="TextBlock">
       <Setter Property="Text" Value="下载此版本 ↓"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding DownloadUrl}" Value="{x:Null}"><Setter Property="Text" Value="前往官网获取 ↗"/></DataTrigger>
        <DataTrigger Binding="{Binding DownloadUrl}" Value=""><Setter Property="Text" Value="前往官网获取 ↗"/></DataTrigger>
       </Style.Triggers>
      </Style></TextBlock.Style>
     </TextBlock>
     <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite">
      <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
       <Setter Property="Visibility" Value="Collapsed"/>
       <Setter Property="Text" Value="{Binding DataContext.ContentMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Text" Value="{Binding DataContext.Status, RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataTrigger>
       </Style.Triggers>
      </Style></TextBlock.Style>
     </TextBlock>
    </StackPanel>
   </Button>
  </DataTemplate>
  <Style x:Key="ResourceCard" TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="20"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Card" CornerRadius="12" Padding="{TemplateBinding Padding}"><Border.Background><SolidColorBrush Color="#EFFFFFFF"/></Border.Background><Border.Effect><DropShadowEffect Color="#24362B" BlurRadius="22" ShadowDepth="5" Opacity="0.06"/></Border.Effect><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#FFFFFFFF" Duration="0:0:0.14"/><DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.10" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#EFFFFFFF" Duration="0:0:0.14"/><DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.06" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="Background" Value="#F3F8F1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="CategoryTab" TargetType="RadioButton" BasedOn="{StaticResource NavButton}"><Setter Property="Width" Value="82"/><Setter Property="Height" Value="48"/><Setter Property="IsEnabled" Value="{Binding CanEditContent}"/></Style>
 </UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="ResourceTabsRow" Height="62"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="ResourceHeader" Height="156" local:PageMotion.HeaderSource="{Binding ElementName=BrowserPanel}"><StackPanel x:Name="ResourceHeading" Margin="0,0,296,0"><TextBlock x:Name="ResourceEyebrow" local:PageMotion.HeaderRole="Eyebrow" Text="DISCOVER / CURATED" Style="{StaticResource Micro}"/><TextBlock x:Name="ResourceTitle" local:PageMotion.HeaderRole="Title" Text="资源下载" Style="{StaticResource PageTitle}"/><TextBlock x:Name="ResourceDescription" local:PageMotion.HeaderRole="Description" TextTrimming="CharacterEllipsis" Text="整合包、模组、资源包与光影。为你的世界，发现更多可能。" FontSize="15" Foreground="{StaticResource MutedBrush}"/></StackPanel>
  <Grid x:Name="ResourceSearch" local:PageMotion.HeaderRole="Actions" Width="270" Height="48" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,36,0,0"><TextBox x:Name="Query" KeyDown="Query_KeyDown" IsEnabled="{Binding CanEditContent}" Text="{Binding ContentQuery, UpdateSourceTrigger=PropertyChanged}" Padding="48,0,44,0" VerticalContentAlignment="Center" AutomationProperties.Name="搜索资源关键词"></TextBox><Path Data="{StaticResource SearchIcon}" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Left" Margin="18,0,0,0" IsHitTestVisible="False"/><TextBlock Text="搜索资源" Margin="48,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ContentQuery}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Click="Search_Click" Style="{StaticResource GhostButton}" Width="42" HorizontalAlignment="Right" Padding="12" AutomationProperties.Name="搜索资源"><Path Data="{StaticResource ArrowIcon}" Stroke="#456553" StrokeThickness="1.5" Stretch="Uniform"/></Button></Grid></Grid>
  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="-24,0,0,0" VerticalAlignment="Top"><RadioButton x:Name="FeaturedTab" GroupName="ResourceCategory" Content="精选" Style="{StaticResource CategoryTab}" IsChecked="True" Checked="Featured_Checked"/><RadioButton x:Name="ModpackTab" GroupName="ResourceCategory" Content="整合包" Tag="Modpack" Style="{StaticResource CategoryTab}" Checked="Category_Checked"/><RadioButton x:Name="ModTab" GroupName="ResourceCategory" Content="模组" Tag="Mod" Style="{StaticResource CategoryTab}" Checked="Category_Checked"/><RadioButton x:Name="ResourcePackTab" GroupName="ResourceCategory" Content="资源包" Tag="ResourcePack" Style="{StaticResource CategoryTab}" Checked="Category_Checked"/><RadioButton x:Name="ShaderTab" GroupName="ResourceCategory" Content="光影" Tag="Shader" Style="{StaticResource CategoryTab}" Checked="Category_Checked"/><RadioButton x:Name="LocalTab" IsEnabled="True" GroupName="ResourceCategory" Content="本地已下载" Style="{StaticResource CategoryTab}" Width="126" Checked="Local_Checked"/></StackPanel>
  <ScrollViewer Grid.Row="2" x:Name="BrowserPanel" local:PageMotion.IsEnabled="True" FocusVisualStyle="{StaticResource KeyboardFocus}" Padding="0,2,6,28" Background="Transparent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><StackPanel>
<Grid x:Name="FeaturedPanel"><Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="发现精选" FontSize="21" FontWeight="Medium"/><Button Content="查看全部 →" Click="BrowseAll_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="0" MinHeight="26"/><UniformGrid x:Name="FeaturedCards" Grid.Row="1" Columns="3" SizeChanged="FeaturedCards_SizeChanged" Margin="-10,0,-10,0"><Grid Margin="10,0,10,20"><Button Style="{StaticResource ResourceCard}" Tag="Mod|Cobblemon" Click="FeaturedResource_Click" ToolTip="查看详情" AutomationProperties.Name="查看 Cobblemon 详情" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><Grid><Grid.RowDefinitions><RowDefinition Height="122"/><RowDefinition Height="42"/><RowDefinition Height="Auto"/><RowDefinition Height="48"/><RowDefinition Height="48"/></Grid.RowDefinitions><Border Background="#DFE8DC" CornerRadius="8"><Path Data="{StaticResource LeafIcon}" Stroke="#456553" StrokeThickness="1.7" Width="52" Height="54" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><DockPanel Grid.Row="1"><TextBlock Text="查看兼容版本" Style="{StaticResource Micro}" DockPanel.Dock="Right" VerticalAlignment="Center"/><TextBlock Text="模组" Foreground="#456553" FontSize="12" VerticalAlignment="Center"/></DockPanel><TextBlock Grid.Row="2" Text="Cobblemon" FontFamily="{StaticResource DisplayFont}" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="Cobblemon" MinHeight="38"/><TextBlock Grid.Row="3" Text="在方块世界中探索、捕捉与养成。" ToolTip="在方块世界中探索、捕捉与养成。" Style="{StaticResource Caption}" FontSize="12" LineHeight="22" LineStackingStrategy="BlockLineHeight" MaxHeight="44" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="4" Text="查看详情 →" Style="{StaticResource Micro}" VerticalAlignment="Center" Margin="0,0,56,0"/></Grid></Button><Button Style="{StaticResource GhostButton}" Tag="Mod|Cobblemon" Click="FeaturedDownload_Click" IsEnabled="{Binding CanEditContent}" Width="44" Height="44" Padding="12" Margin="0,0,20,20" HorizontalAlignment="Right" VerticalAlignment="Bottom" AutomationProperties.Name="下载 Cobblemon" ToolTip="下载并安装 · 选择兼容版本"><Path Data="{StaticResource DownloadIcon}" Stroke="#456553" StrokeThickness="1.8" Stretch="Uniform"/></Button></Grid><Grid Margin="10,0,10,20"><Button Style="{StaticResource ResourceCard}" Tag="Shader|Complementary" Click="FeaturedResource_Click" ToolTip="查看详情" AutomationProperties.Name="查看 Complementary 详情" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><Grid><Grid.RowDefinitions><RowDefinition Height="122"/><RowDefinition Height="42"/><RowDefinition Height="Auto"/><RowDefinition Height="48"/><RowDefinition Height="48"/></Grid.RowDefinitions><Border Background="#DFE7E9" CornerRadius="8"><Path Data="{StaticResource SunIcon}" Stroke="#456553" StrokeThickness="1.7" Width="52" Height="54" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><DockPanel Grid.Row="1"><TextBlock Text="查看兼容版本" Style="{StaticResource Micro}" DockPanel.Dock="Right" VerticalAlignment="Center"/><TextBlock Text="光影" Foreground="#456553" FontSize="12" VerticalAlignment="Center"/></DockPanel><TextBlock Grid.Row="2" Text="Complementary" FontFamily="{StaticResource DisplayFont}" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="Complementary" MinHeight="38"/><TextBlock Grid.Row="3" Text="柔和光照与细腻体积云，适合日常游玩。" ToolTip="柔和光照与细腻体积云，适合日常游玩。" Style="{StaticResource Caption}" FontSize="12" LineHeight="22" LineStackingStrategy="BlockLineHeight" MaxHeight="44" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="4" Text="查看详情 →" Style="{StaticResource Micro}" VerticalAlignment="Center" Margin="0,0,56,0"/></Grid></Button><Button Style="{StaticResource GhostButton}" Tag="Shader|Complementary" Click="FeaturedDownload_Click" IsEnabled="{Binding CanEditContent}" Width="44" Height="44" Padding="12" Margin="0,0,20,20" HorizontalAlignment="Right" VerticalAlignment="Bottom" AutomationProperties.Name="下载 Complementary" ToolTip="下载并安装 · 选择兼容版本"><Path Data="{StaticResource DownloadIcon}" Stroke="#456553" StrokeThickness="1.8" Stretch="Uniform"/></Button></Grid><Grid Margin="10,0,10,20"><Button Style="{StaticResource ResourceCard}" Tag="ResourcePack|Fresh Animations" Click="FeaturedResource_Click" ToolTip="查看详情" AutomationProperties.Name="查看 Fresh Animations 详情" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><Grid><Grid.RowDefinitions><RowDefinition Height="122"/><RowDefinition Height="42"/><RowDefinition Height="Auto"/><RowDefinition Height="48"/><RowDefinition Height="48"/></Grid.RowDefinitions><Border Background="#EAE6DC" CornerRadius="8"><Path Data="{StaticResource CubeIcon}" Stroke="#456553" StrokeThickness="1.7" Width="52" Height="54" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><DockPanel Grid.Row="1"><TextBlock Text="查看兼容版本" Style="{StaticResource Micro}" DockPanel.Dock="Right" VerticalAlignment="Center"/><TextBlock Text="资源包" Foreground="#456553" FontSize="12" VerticalAlignment="Center"/></DockPanel><TextBlock Grid.Row="2" Text="Fresh Animations" FontFamily="{StaticResource DisplayFont}" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="Fresh Animations" MinHeight="38"/><TextBlock Grid.Row="3" Text="让生物动作更自然，同时保留原版风格。" ToolTip="让生物动作更自然，同时保留原版风格。" Style="{StaticResource Caption}" FontSize="12" LineHeight="22" LineStackingStrategy="BlockLineHeight" MaxHeight="44" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Row="4" Text="查看详情 →" Style="{StaticResource Micro}" VerticalAlignment="Center" Margin="0,0,56,0"/></Grid></Button><Button Style="{StaticResource GhostButton}" Tag="ResourcePack|Fresh Animations" Click="FeaturedDownload_Click" IsEnabled="{Binding CanEditContent}" Width="44" Height="44" Padding="12" Margin="0,0,20,20" HorizontalAlignment="Right" VerticalAlignment="Bottom" AutomationProperties.Name="下载 Fresh Animations" ToolTip="下载并安装 · 选择兼容版本"><Path Data="{StaticResource DownloadIcon}" Stroke="#456553" StrokeThickness="1.8" Stretch="Uniform"/></Button></Grid></UniformGrid><TextBlock Grid.Row="2" Text="下载前请核对游戏版本与加载器要求。资源不会自动覆盖现有文件。" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"/></Grid><Grid x:Name="BrowserContent" Visibility="Collapsed" MinHeight="465"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><Grid IsEnabled="{Binding CanEditContent}"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="130"/><ColumnDefinition Width="150"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><ComboBox x:Name="Platform" ItemsSource="{Binding ContentPlatforms}" SelectedValue="{Binding ContentPlatform}" SelectedValuePath="Value" DisplayMemberPath="Label" AutomationProperties.Name="资源平台" Margin="0,0,12,0"/><ComboBox Grid.Column="1" x:Name="Kind" ItemsSource="{Binding ContentKinds}" SelectedValue="{Binding ContentKind}" SelectedValuePath="Value" DisplayMemberPath="Label" AutomationProperties.Name="资源类型" Margin="0,0,12,0"/><TextBox Grid.Column="2" Tag="游戏版本" Text="{Binding ContentGameVersion, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="筛选游戏版本" ToolTip="游戏版本，留空不限" Margin="0,0,12,0"/><ComboBox Grid.Column="3" x:Name="Loader" ItemsSource="{Binding ContentLoaders}" SelectedValue="{Binding ContentLoader}" SelectedValuePath="Value" DisplayMemberPath="Label" AutomationProperties.Name="加载器或光影支持"/><Button Grid.Column="5" Command="{Binding SearchContentCommand}" Content="搜索" Style="{StaticResource PrimaryButton}" MinHeight="46"/></Grid><TextBlock Text="{Binding ContentSearchHint}" Style="{StaticResource Caption}" FontSize="11" Margin="0,10,0,16" TextWrapping="Wrap"/></StackPanel>
   <Grid Grid.Row="1" MinHeight="280"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="资源项目" FontWeight="SemiBold"/><ListBox ScrollViewer.VerticalScrollBarVisibility="Disabled" x:Name="ProjectsList" SelectionChanged="ProjectsList_SelectionChanged" Grid.Row="1" ItemsSource="{Binding ContentProjects}" SelectedItem="{Binding SelectedContentProject}" IsEnabled="{Binding CanEditContent}" AutomationProperties.Name="资源项目"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayTitle}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="11" Margin="0,7,0,0"/><TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Margin="0,10,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="1" Margin="15,25,15,0" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ContentProjects.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="{Binding ContentEmptyTitle}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding ContentEmptyHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel><StackPanel Grid.Row="2" Margin="0,14,0,0"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="‹" Command="{Binding PreviousContentPageCommand}" Style="{StaticResource GhostButton}" Width="32" Padding="5" AutomationProperties.Name="上一页"/><Button Content="›" Command="{Binding NextContentPageCommand}" Style="{StaticResource GhostButton}" Width="32" Padding="5" AutomationProperties.Name="下一页"/></StackPanel><StackPanel Orientation="Horizontal"><Button Content="查看版本" Command="{Binding LoadContentFilesCommand}"/><Button Content="项目网页" Command="{Binding OpenContentWebsiteCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/></StackPanel></DockPanel><TextBlock Text="{Binding ContentPageLabel}" Style="{StaticResource Micro}" Margin="0,6,0,0"/></StackPanel></Grid>
    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ContentSelectionHint}" ToolTip="{Binding ContentSelectionHint}" Style="{StaticResource Caption}" FontSize="11" MaxWidth="280" TextTrimming="CharacterEllipsis"/><TextBlock Text="版本与文件" FontWeight="SemiBold"/></DockPanel><ListBox ScrollViewer.VerticalScrollBarVisibility="Disabled" x:Name="FilesList" Grid.Row="1" ItemsSource="{Binding ContentFiles}" SelectedItem="{Binding SelectedContentFile}" IsEnabled="{Binding CanEditContent}" AutomationProperties.Name="资源版本与文件" ItemContainerStyle="{StaticResource FileRow}" ItemTemplate="{StaticResource DownloadableFile}"/><StackPanel Grid.Row="1" Margin="15,25,15,0" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ContentFiles.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="选择适合你的版本" FontSize="19" FontWeight="SemiBold"/><TextBlock TextWrapping="Wrap" Margin="0,12,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Text" Value="{Binding ContentMessage}"/><Style.Triggers><DataTrigger Binding="{Binding SelectedContentProject}" Value="{x:Null}"><Setter Property="Text" Value="选中左侧项目后会自动加载兼容版本；加载失败时可点击“查看版本”重试。"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel><StackPanel Grid.Row="2" Margin="0,14,0,0"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="‹" Command="{Binding PreviousFilesPageCommand}" Style="{StaticResource GhostButton}" Width="32" Padding="5" AutomationProperties.Name="文件上一页"/><Button Content="›" Command="{Binding NextFilesPageCommand}" Style="{StaticResource GhostButton}" Width="32" Padding="5" AutomationProperties.Name="文件下一页"/></StackPanel><StackPanel Orientation="Horizontal"><Button Content="下载所选文件" Command="{Binding DownloadContentCommand}"/><Button Content="文件网页" Command="{Binding OpenContentFileWebsiteCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/></StackPanel></DockPanel><TextBlock Text="{Binding FilesPageLabel}" Style="{StaticResource Micro}" Margin="0,6,0,0"/></StackPanel></Grid>
   </Grid>
   <StackPanel Grid.Row="2" Margin="0,22,0,0"><TextBlock Text="{Binding ContentMessage}" Style="{StaticResource Caption}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{Binding ContentDownloadHint}" Style="{StaticResource Caption}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/><DockPanel Margin="0,5,0,0"><Button DockPanel.Dock="Right" Content="打开下载目录" Command="{Binding OpenContentFolderCommand}" Style="{StaticResource GhostButton}"/><TextBlock Text="{Binding ContentDestination, StringFormat=下载到：{0}}" Style="{StaticResource Micro}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ContentDestination}"/></DockPanel><Expander Header="连接选项与 CurseForge 密钥" Margin="0,12,0,0" IsEnabled="{Binding CanEditContent}"><StackPanel Margin="0,18,0,12"><CheckBox Content="使用系统代理" IsChecked="{Binding ContentUseSystemProxy}"/><TextBlock Text="连接失败时可切换为直连。不会修改 Windows 代理设置。" Style="{StaticResource Caption}" Margin="0,10,0,16"/><PasswordBox x:Name="ApiKey" MaxLength="512" PasswordChanged="ApiKey_PasswordChanged" AutomationProperties.Name="CurseForge API Key"/><TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0"><Run Text="密钥仅在本次运行中使用。"/><Hyperlink NavigateUri="https://console.curseforge.com/" RequestNavigate="ApiConsole_RequestNavigate">申请 CurseForge API Key</Hyperlink></TextBlock></StackPanel></Expander></StackPanel>
  </Grid>
<StackPanel x:Name="DetailPanel" Visibility="Collapsed"><Button Content="← 返回精选" Click="BackToFeatured_Click" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"/><TextBlock Text="{Binding SelectedContentProject.DisplayTitle}" FontSize="28" FontWeight="SemiBold" Margin="0,20,0,12" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedContentProject.Description}" Style="{StaticResource Caption}" TextWrapping="Wrap"/><TextBlock Text="兼容版本" Style="{StaticResource SectionTitle}" Margin="0,28,0,16"/><ListBox x:Name="DetailFilesList" ItemsSource="{Binding ContentFiles}" SelectedItem="{Binding SelectedContentFile}" IsEnabled="{Binding CanEditContent}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="精选资源版本与文件" ItemContainerStyle="{StaticResource FileRow}" ItemTemplate="{StaticResource DownloadableFile}"/><WrapPanel Margin="0,20,0,12"><Button Content="下载所选文件" Command="{Binding DownloadContentCommand}"/><Button Content="上一页版本" Command="{Binding PreviousFilesPageCommand}" Margin="12,0,0,0"/><Button Content="下一页版本" Command="{Binding NextFilesPageCommand}" Margin="12,0,0,0"/><Button Content="项目网页" Command="{Binding OpenContentWebsiteCommand}" Style="{StaticResource GhostButton}"/></WrapPanel><TextBlock Text="{Binding ContentSelectionHint}" Style="{StaticResource Caption}" TextWrapping="Wrap"/><TextBlock Text="{Binding ContentMessage}" Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding ContentDownloadHint}" Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel>
</StackPanel></ScrollViewer><local:LocalDownloadsView x:Name="LocalPanel" Grid.Row="2" Visibility="Collapsed"/>
