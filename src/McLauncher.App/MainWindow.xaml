<Window x:Class="McLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MC Launcher" Width="1080" Height="720" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,12">
      <TextBlock FontSize="24" FontWeight="SemiBold" Text="Minecraft Java 启动器" />
      <TextBlock Margin="0,4,0,0" Foreground="DimGray"
                 Text="原版 · 微软正版 / 离线 · Java 自动检测与下载" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="390" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <GroupBox Header="账号" Padding="10" Margin="0,0,0,10">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <RadioButton Content="微软正版" IsChecked="{Binding UseMicrosoft}" Margin="0,0,18,0" />
                <RadioButton Content="离线" IsChecked="{Binding UseOffline}" />
              </StackPanel>
              <TextBlock Text="微软账号" />
              <DockPanel Margin="0,4,0,8">
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="登录" Command="{Binding LoginMicrosoftCommand}" />
                <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                          DisplayMemberPath="DisplayName" IsEnabled="{Binding UseMicrosoft}" />
              </DockPanel>
              <TextBlock Text="离线用户名" />
              <TextBox Margin="0,4,0,0" Text="{Binding OfflineUsername, UpdateSourceTrigger=PropertyChanged}"
                       IsEnabled="{Binding UseOffline}" MaxLength="16" />
              <TextBlock Margin="0,8,0,0" Text="设备代码" />
              <TextBox Margin="0,4,0,0" Text="{Binding DeviceCode, Mode=OneWay}" IsReadOnly="True"
                       FontFamily="Consolas" ToolTip="登录时会自动复制并打开微软验证页面" />
            </StackPanel>
          </GroupBox>

          <GroupBox Header="游戏" Padding="10" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="版本（本地优先）" />
              <DockPanel Margin="0,4,0,8">
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="刷新" Command="{Binding RefreshCommand}" />
                <ComboBox ItemsSource="{Binding Versions}" Text="{Binding SelectedVersion, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True" IsTextSearchEnabled="True" />
              </DockPanel>
              <TextBlock Text="游戏目录" />
              <DockPanel Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="浏览…" Click="BrowseDirectory_Click" />
                <TextBox Text="{Binding GameDirectory, UpdateSourceTrigger=PropertyChanged}" />
              </DockPanel>
              <TextBlock Margin="0,5,0,0" Foreground="DimGray" TextWrapping="Wrap"
                         Text="可选择 .minecraft 根目录，或 versions 下的具体版本目录" />
            </StackPanel>
          </GroupBox>

          <GroupBox Header="运行" Padding="10">
            <StackPanel>
              <DockPanel>
                <TextBlock Text="最大内存" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding MemoryMb, StringFormat={}{0} MB}" />
              </DockPanel>
              <Slider Margin="0,6,0,8" Minimum="1024" Maximum="32768" TickFrequency="1024"
                      IsSnapToTickEnabled="True" Value="{Binding MemoryMb}" />
              <TextBlock Text="Java" />
              <TextBlock Margin="0,4,0,0" Text="{Binding JavaStatus}" TextWrapping="Wrap" Foreground="DimGray" />
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>

      <GroupBox Grid.Column="2" Header="启动及游戏日志" Padding="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="清空" Command="{Binding ClearLogsCommand}" MinHeight="26" />
            <TextBlock VerticalAlignment="Center" Foreground="DimGray" Text="最多保留最近 1000 行" />
          </DockPanel>
          <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Logs}"
                   FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Grid>
      </GroupBox>
    </Grid>

    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                   IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}" />
      <DockPanel Grid.Row="1" Margin="0,8,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="下载 / 修复" Command="{Binding RepairCommand}" Margin="0,0,8,0" />
          <Button Content="启动游戏" Command="{Binding LaunchCommand}" Margin="0,0,8,0" MinWidth="100" />
          <Button Content="取消" Command="{Binding CancelCommand}" />
        </StackPanel>
        <TextBlock VerticalAlignment="Center" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Grid>
  </Grid>
</Window>

