     <Button Tag="Home" Click="Navigate_Click" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="0" AutomationProperties.Name="LATTICE 启动主页"><StackPanel Orientation="Horizontal"><UniformGrid Rows="2" Columns="2" Width="31" Height="31" Margin="0,0,16,0"><Rectangle Fill="#1B3025" Margin="0,0,2,2"/><Rectangle Fill="#657E6B" Margin="0,0,0,2"/><Rectangle Fill="#839885" Margin="0,0,2,0"/><Rectangle Fill="#456553"/></UniformGrid><StackPanel><TextBlock Text="LATTICE" FontFamily="Segoe UI" FontSize="23" Foreground="{StaticResource TextBrush}"/><TextBlock Text="M I N E C R A F T  L A U N C H E R" FontFamily="Segoe UI" FontSize="7" Foreground="{StaticResource FaintBrush}" Margin="1,1,0,0"/></StackPanel></StackPanel></Button>
