     <ListBox Padding="0,0,12,28" x:Name="ModsList" Grid.Row="2" ItemsSource="{Binding FilteredMods}" ItemContainerStyle="{StaticResource ModRow}" AutomationProperties.Name="已安装模组列表"><ListBox.ItemTemplate><DataTemplate><Grid Height="52"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><Border Background="#E0E8DF" Width="42" Height="42" CornerRadius="4" HorizontalAlignment="Left"><Path Data="{StaticResource CubeIcon}" Stroke="#456553" StrokeThickness="1.6" Width="20" Height="22" Stretch="Uniform"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" FontSize="17" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/><TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding ProjectName}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="3" Text="{Binding FileSize}" Style="{StaticResource Caption}" VerticalAlignment="Center"/><CheckBox Grid.Column="4" Margin="0,0,12,0" Style="{StaticResource Switch}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" IsEnabled="{Binding DataContext.CanEditContent, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding DisplayName}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2" HorizontalAlignment="Left" Margin="0,60,0,0" Visibility="{Binding HasNoFilteredMods, Converter={StaticResource BoolVisibility}}"><TextBlock Text="没有找到模组" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="尝试其他关键词，或从资源页为当前实例添加模组。" Style="{StaticResource Caption}" Margin="0,15,0,0"/><Button Content="浏览模组 →" Tag="Mod" Click="BrowseResources_Click" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel>
    </Grid>
    <Grid x:Name="ResourcesView" Visibility="{Binding IsContentPage, Converter={StaticResource BoolVisibility}}"><local:ContentDownloadsView x:Name="ResourcesBrowser"/></Grid>
