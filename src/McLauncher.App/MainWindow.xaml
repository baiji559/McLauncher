     </StackPanel></ScrollViewer>
    </Grid>
    <Grid x:Name="ModsView" Visibility="{Binding IsModsPage, Converter={StaticResource BoolVisibility}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid x:Name="ModsHeader" Height="160" local:PageMotion.HeaderSource="{Binding ElementName=ModsList}"><StackPanel Margin="0,0,240,0"><TextBlock local:PageMotion.HeaderRole="Eyebrow" Text="{Binding InstalledMods.Count, StringFormat=INSTANCE CONTENT / {0}}" Style="{StaticResource Micro}"/><TextBlock local:PageMotion.HeaderRole="Title" Text="模组管理" Style="{StaticResource PageTitle}"/><TextBlock local:PageMotion.HeaderRole="Description" TextTrimming="CharacterEllipsis" Text="{Binding ModDescription}" FontSize="15" Foreground="{StaticResource MutedBrush}"/></StackPanel><Button local:PageMotion.HeaderRole="Actions" Tag="Mod" Click="BrowseResources_Click" Style="{StaticResource PrimaryButton}" Width="218" Height="52" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,32,0,0"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource PlusIcon}" Stroke="White" StrokeThickness="1.8" Width="17" Height="17" Stretch="Uniform" Margin="0,0,14,0"/><TextBlock Text="添加模组"/></StackPanel></Button></Grid>
