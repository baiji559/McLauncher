<Window x:Class="McLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:McLauncher.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MC Launcher" Width="1280" Height="820" MinWidth="1020" MinHeight="680"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <DataTemplate x:Key="LocalVersionRow">
      <Button Click="UseVersion_Click" Tag="{Binding Id}" Style="{StaticResource VersionRowButton}"
              IsEnabled="{Binding DataContext.CanEditContent, RelativeSource={RelativeSource AncestorType=Window}}"
              AutomationProperties.Name="{Binding Id}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40" /><ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="12" />
          </Grid.ColumnDefinitions>
          <Image x:Name="VersionIcon" Source="{StaticResource GrassBlock}" Width="40" Height="44" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock x:Name="VersionTitle" Style="{StaticResource BalancedTitleText}" FontFamily="{StaticResource MonoFont}"
                       FontSize="17" FontWeight="Medium" LineHeight="24" MaxHeight="48" Foreground="{StaticResource TextBrush}" ToolTip="{Binding Id}">
              <TextBlock.Text><MultiBinding Converter="{StaticResource BalancedTitle}"><Binding Path="Id" /><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding RelativeSource="{RelativeSource Self}" /></MultiBinding></TextBlock.Text>
            </TextBlock>
            <TextBlock Text="{Binding Detail}" Style="{StaticResource MonoCaption}" FontSize="13" LineHeight="20" Margin="0,2,0,0" />
          </StackPanel>
          <Path x:Name="VersionChevron" Grid.Column="4" Data="M 1,1 L 6,6 1,11" Width="6" Height="12"
                Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Grid>
      </Button>
    </DataTemplate>
    <Style x:Key="VersionListItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="WindowFrame" BorderThickness="0" Background="{StaticResource CanvasBrush}">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="204" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /><RowDefinition Height="40" /></Grid.RowDefinitions>

      <!-- A quiet, persistent navigation rail. -->
      <Border Grid.RowSpan="3" Background="#141B17" BorderBrush="#303A31" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="112" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="25,0,18,0" VerticalAlignment="Center">
            <Image Source="{StaticResource GrassBlock}" Width="32" Height="36" Margin="0,0,12,0" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="MC Launcher" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="JAVA EDITION" Foreground="{StaticResource FaintBrush}" FontSize="9" Margin="1,5,0,0" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Row="1">
            <TextBlock Text="游戏" Style="{StaticResource Caption}" Foreground="{StaticResource FaintBrush}" Margin="30,4,0,12" />
            <RadioButton x:Name="HomeNavigation" GroupName="Navigation" Style="{StaticResource NavButton}" IsChecked="{Binding IsHomePage}" AutomationProperties.Name="首页">
              <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" FontSize="17" Width="34" /><TextBlock Text="首页" /></StackPanel>
            </RadioButton>
            <RadioButton x:Name="VersionsNavigation" GroupName="Navigation" Style="{StaticResource NavButton}" IsChecked="{Binding IsVersionsPage}" AutomationProperties.Name="游戏版本">
              <StackPanel Orientation="Horizontal"><Grid Width="34"><Path Data="{StaticResource CubeIcon}" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.2" Width="16" Height="18" Stretch="Uniform" HorizontalAlignment="Left" /></Grid><TextBlock Text="游戏版本" /></StackPanel>
            </RadioButton>
            <RadioButton x:Name="ContentNavigation" GroupName="Navigation" Style="{StaticResource NavButton}" IsChecked="{Binding IsContentPage}" AutomationProperties.Name="资源中心">
              <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" FontSize="17" Width="34" /><TextBlock Text="资源中心" /></StackPanel>
            </RadioButton>
            <Border Height="1" Background="#2C352D" Margin="28,23,28,19" />
            <RadioButton x:Name="SettingsNavigation" GroupName="Navigation" Style="{StaticResource NavButton}" IsChecked="{Binding IsSettingsPage}" AutomationProperties.Name="设置">
              <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="17" Width="34" /><TextBlock Text="设置" /></StackPanel>
            </RadioButton>
            <RadioButton x:Name="LogsNavigation" GroupName="Navigation" Style="{StaticResource NavButton}" IsChecked="{Binding IsLogsPage}" AutomationProperties.Name="运行日志">
              <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE756;" FontSize="17" Width="34" /><TextBlock Text="运行日志" /></StackPanel>
            </RadioButton>
          </StackPanel>
          <StackPanel Grid.Row="2" Margin="16,0,16,20">
            <Border Height="1" Background="#2C352D" Margin="10,0,10,14" />
            <Button Style="{StaticResource GhostButton}" Tag="Settings" Click="Navigate_Click" Padding="8,12" HorizontalContentAlignment="Stretch" AutomationProperties.Name="账号设置">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /></Grid.ColumnDefinitions>
                <Image Source="{StaticResource PlayerFace}" Width="30" Height="30" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding AccountDisplayName}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding AccountModeLabel}" Style="{StaticResource Caption}" FontSize="10" Margin="0,4,0,0" /></StackPanel>
                <TextBlock Grid.Column="2" Text="›" VerticalAlignment="Center" FontSize="18" />
              </Grid>
            </Button>
            <TextBlock Text="MC Launcher  /  Windows" Foreground="#59685C" FontSize="10" Margin="10,16,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- WindowChrome preserves native dragging, resize and snap behavior. -->
      <Grid Grid.Column="1" Background="#181E1B">
        <TextBlock Text="Minecraft 启动器" Foreground="#788779" FontSize="11" Margin="24,0,0,0" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="Minimize_Click" AutomationProperties.Name="最小化" />
          <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Content="&#xE922;" Click="Maximize_Click" AutomationProperties.Name="最大化或还原" />
          <Button Style="{StaticResource WindowButton}" Content="&#xE8BB;" Click="Close_Click" AutomationProperties.Name="关闭" />
        </StackPanel>
      </Grid>

      <Grid Grid.Column="1" Grid.Row="1" ClipToBounds="True">
        <Grid x:Name="HomeView" Visibility="{Binding IsHomePage, Converter={StaticResource BoolVisibility}}">
          <Grid Height="440" VerticalAlignment="Top" IsHitTestVisible="False">
            <Image Source="Assets/overworld-sunset.png" Stretch="UniformToFill" />
            <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#A3141D16" Offset="0" /><GradientStop Color="#10141D16" Offset="0.8" /></LinearGradientBrush></Border.Background></Border>
            <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00181E1B" Offset="0.25" /><GradientStop Color="#40181E1B" Offset="0.6" /><GradientStop Color="#FF181E1B" Offset="1" /></LinearGradientBrush></Border.Background></Border>
          </Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="36,0,36,24">
              <Grid Height="258">
                <StackPanel VerticalAlignment="Center" Margin="0,0,0,8">
                  <TextBlock Text="MINECRAFT: JAVA EDITION" Foreground="#D1DAC2" FontSize="10" FontWeight="SemiBold" Margin="1,0,0,16" />
                  <TextBlock Text="回到你的世界。" FontSize="38" FontWeight="SemiBold" Foreground="#F6F4E9" />
                  <TextBlock Text="从这里，继续下一段冒险。" Foreground="#D0D5C8" FontSize="14" Margin="2,13,0,0" />
                </StackPanel>
                <TextBlock Text="THE OVERWORLD" FontSize="9" Foreground="#B4C0AB" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,28" />
              </Grid>

              <Grid>
                <Border Style="{StaticResource Surface}" Background="#F0232D25" />
                <Grid Margin="24,21,24,0">
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="82" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Image Source="{StaticResource GrassBlock}" Width="58" Height="64" HorizontalAlignment="Left" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal"><Ellipse Fill="{StaticResource AccentBrush}" Width="5" Height="5" Margin="0,0,6,0" /><TextBlock Text="{Binding InstallationLabel}" Foreground="#A9C69A" FontSize="11" /></StackPanel>
                    <TextBlock x:Name="SelectedVersionTitle" Style="{StaticResource BalancedTitleText}" FontFamily="{StaticResource MonoFont}"
                               FontSize="23" LineHeight="30" MaxHeight="60" Margin="0,6,0,3" ToolTip="{Binding SelectedVersionDisplay}">
                      <TextBlock.Text><MultiBinding Converter="{StaticResource BalancedTitle}"><Binding Path="SelectedVersionDisplay" /><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" /><Binding RelativeSource="{RelativeSource Self}" /></MultiBinding></TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="Minecraft: Java Edition" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button x:Name="HomeLaunchButton" Command="{Binding LaunchCommand}" Style="{StaticResource PrimaryButton}" Width="174" Height="49" FontSize="16" AutomationProperties.Name="启动游戏">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0" /><TextBlock Text="{Binding LaunchButtonLabel}" /></StackPanel>
                    </Button>
                    <Button Content="切换版本  ›" Style="{StaticResource GhostButton}" Tag="Versions" Click="Navigate_Click" Margin="0,4,0,0" FontSize="11" MinHeight="25" Padding="8,3" />
                  </StackPanel>
                  <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#3B483B" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,10,0,10">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="启动设置  ↗" Style="{StaticResource GhostButton}" Tag="Settings" Click="Navigate_Click" FontSize="11" MinHeight="24" Padding="0,2" />
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedLoaderLabel}" Style="{StaticResource Caption}" />
                        <TextBlock Text="  /  " Foreground="#5C6A5B" />
                        <TextBlock Text="Java 自动" Style="{StaticResource Caption}" />
                        <TextBlock Text="  /  " Foreground="#5C6A5B" />
                        <TextBlock Text="{Binding MemoryLabel}" Style="{StaticResource MonoCaption}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </Grid>
              </Grid>

              <Grid Margin="0,28,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.14*" /><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="全部版本  ›" Style="{StaticResource LinkButton}" Tag="Versions" Click="Navigate_Click" Padding="0,0" MinHeight="24" /><TextBlock Text="我的版本" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" /></DockPanel>
                  <Grid Visibility="{Binding HasLocalVersions, Converter={StaticResource BoolVisibility}}">
                    <Border Style="{StaticResource Surface}" Background="#202922" />
                    <ItemsControl x:Name="RecentVersionList" ItemsSource="{Binding RecentVersions}" ItemTemplate="{StaticResource LocalVersionRow}" Margin="8" />
                  </Grid>
                  <StackPanel Margin="0,22,0,20" Visibility="{Binding HasNoLocalVersions, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="还没有本地版本" FontSize="14" />
                    <TextBlock Text="选择一个版本，下载后就能开始。" Style="{StaticResource Caption}" Margin="0,7,0,15" />
                    <Button Content="选择游戏版本  →" Style="{StaticResource GhostButton}" Tag="Versions" Click="Navigate_Click" HorizontalAlignment="Left" Padding="0,5" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="资源中心  ›" Style="{StaticResource LinkButton}" Tag="Content" Click="Navigate_Click" Padding="0,0" MinHeight="24" /><TextBlock Text="模组与资源" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" /></DockPanel>
                  <Border Height="1" Background="{StaticResource LineBrush}" />
                  <ItemsControl ItemsSource="{Binding InstalledMods}" Margin="0,10,0,6" Visibility="{Binding HasInstalledMods, Converter={StaticResource BoolVisibility}}">
                    <ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,9"><Ellipse DockPanel.Dock="Right" Width="5" Height="5" Fill="{StaticResource AccentBrush}" Margin="10,0,0,0" /><TextBlock Text="{Binding DisplayName}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" /></DockPanel></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Visibility="{Binding HasNoInstalledMods, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,0">
                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="0,12" Tag="Mod" Click="BrowseResources_Click">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="39" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions><Path Data="{StaticResource CubeIcon}" Stroke="#93AF83" StrokeThickness="1.2" Width="18" Height="20" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" /><StackPanel Grid.Column="1"><TextBlock Text="浏览模组" Foreground="{StaticResource TextBrush}" /><TextBlock Text="搜索 Modrinth 与 CurseForge" Style="{StaticResource Caption}" FontSize="11" Margin="0,5,0,0" /></StackPanel><TextBlock Grid.Column="2" Text="›" VerticalAlignment="Center" FontSize="20" /></Grid>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="0,12" Tag="Shader" Click="BrowseResources_Click">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="39" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions><TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="#B7AA7A" VerticalAlignment="Center" /><StackPanel Grid.Column="1"><TextBlock Text="浏览光影" Foreground="{StaticResource TextBrush}" /><TextBlock Text="按游戏版本与光影支持筛选" Style="{StaticResource Caption}" FontSize="11" Margin="0,5,0,0" /></StackPanel><TextBlock Grid.Column="2" Text="›" VerticalAlignment="Center" FontSize="20" /></Grid>
                    </Button>
                  </StackPanel>
                  <TextBlock Text="{Binding InstalledModSummary}" Style="{StaticResource MonoCaption}" Margin="0,10,0,0" Visibility="{Binding HasInstalledMods, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
              </Grid>
              <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,25,0,0" Padding="0,13,0,0">
                <DockPanel><Button DockPanel.Dock="Right" Content="打开文件夹  ↗" Command="{Binding OpenGameFolderCommand}" Style="{StaticResource GhostButton}" MinHeight="25" FontSize="11" Padding="0,3" Margin="18,0,0,0" /><StackPanel><TextBlock Text="当前游戏目录" FontSize="10" Foreground="{StaticResource FaintBrush}" /><TextBlock Text="{Binding GameDirectory}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding GameDirectory}" /></StackPanel></DockPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <Grid x:Name="VersionsView" Margin="36,30,36,24" Visibility="{Binding IsVersionsPage, Converter={StaticResource BoolVisibility}}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="游戏版本" Style="{StaticResource PageTitle}" /><TextBlock Text="选择熟悉的版本，或者开始一个新的世界。" Style="{StaticResource Caption}" /></StackPanel>
          <Grid Grid.Row="1" Margin="0,28,0,28">
            <Border Style="{StaticResource Surface}" />
            <StackPanel Margin="24" IsEnabled="{Binding CanEditContent}">
              <TextBlock Text="选择或输入版本" FontWeight="SemiBold" />
              <Grid Margin="0,12,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ComboBox x:Name="VersionSelector" FontFamily="{StaticResource MonoFont}" ItemsSource="{Binding Versions}" Text="{Binding SelectedVersion, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsTextSearchEnabled="True" AutomationProperties.Name="游戏版本选择" />
                <Button Grid.Column="1" Content="刷新列表" Command="{Binding RefreshCommand}" Margin="12,0,0,0" />
                <Button Grid.Column="2" Content="下载 / 修复" Command="{Binding RepairCommand}" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" />
              </Grid>
              <TextBlock Text="列表优先显示本地版本；也可以直接输入版本号，例如 1.21.1。" Style="{StaticResource Caption}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
          <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,16"><TextBlock DockPanel.Dock="Right" Text="{Binding LocalVersionSummary}" Style="{StaticResource MonoCaption}" VerticalAlignment="Center" /><TextBlock Text="已安装" Style="{StaticResource SectionTitle}" /></DockPanel>
            <Grid Grid.Row="1">
              <Border Style="{StaticResource Surface}" Background="#202922" />
              <ListBox x:Name="InstalledVersionList" ItemsSource="{Binding LocalVersions}" IsEnabled="{Binding CanEditContent}"
                       ItemTemplate="{StaticResource LocalVersionRow}" ItemContainerStyle="{StaticResource VersionListItem}"
                       Margin="8" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Grid>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasNoLocalVersions, Converter={StaticResource BoolVisibility}}"><Image Source="{StaticResource GrassBlock}" Width="42" Height="46" Opacity="0.6" Margin="0,0,0,16" /><TextBlock Text="本地版本会显示在这里" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="从上方选择版本并下载，或在设置中选择已有游戏目录。" Style="{StaticResource Caption}" Margin="0,10,0,0" /></StackPanel>
          </Grid>
        </Grid>

        <Grid x:Name="ResourcesView" Margin="36,30,36,24" Visibility="{Binding IsContentPage, Converter={StaticResource BoolVisibility}}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,24"><TextBlock Text="资源中心" Style="{StaticResource PageTitle}" /><TextBlock Text="模组、整合包、光影和资源包，找到适合你的那一个。" Style="{StaticResource Caption}" /></StackPanel>
          <local:ContentDownloadsView Grid.Row="1" />
        </Grid>

        <ScrollViewer x:Name="SettingsView" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolVisibility}}">
          <StackPanel Margin="36,30,36,30" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="设置" Style="{StaticResource PageTitle}" /><TextBlock Text="让启动器按你的习惯工作。设置会在关闭时保存。" Style="{StaticResource Caption}" Margin="0,0,0,30" />
            <GroupBox Header="游戏账号" Padding="0,0,0,26">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20" IsEnabled="{Binding CanEditContent}"><RadioButton Content="微软正版" GroupName="AccountMode" IsChecked="{Binding UseMicrosoft}" Margin="0,0,30,0" /><RadioButton Content="离线账号" GroupName="AccountMode" IsChecked="{Binding UseOffline}" /></StackPanel>
                <Grid IsEnabled="{Binding CanEditContent}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="微软账号" Style="{StaticResource Caption}" /><DockPanel Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="登录" Command="{Binding LoginMicrosoftCommand}" Margin="10,0,0,0" /><ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="Username" IsEnabled="{Binding UseMicrosoft}" AutomationProperties.Name="微软账号" /></DockPanel></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="离线用户名" Style="{StaticResource Caption}" /><TextBox Text="{Binding OfflineUsername, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" IsEnabled="{Binding UseOffline}" Margin="0,8,0,0" MaxLength="16" AutomationProperties.Name="离线用户名" /></StackPanel>
                </Grid>
                <DockPanel Margin="0,17,0,0"><TextBlock Text="登录代码" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,16,0" /><TextBox Text="{Binding DeviceCode, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" Width="150" HorizontalAlignment="Left" ToolTip="登录时自动复制，并打开微软验证页面" /></DockPanel>
                <TextBlock Text="微软登录时，在打开的验证页面中输入代码即可。" Style="{StaticResource Caption}" Margin="0,8,0,0" />
              </StackPanel>
            </GroupBox>
            <GroupBox Header="游戏目录" Padding="0,0,0,26">
              <StackPanel IsEnabled="{Binding CanEditContent}"><DockPanel><Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseDirectory_Click" Margin="12,0,0,0" /><TextBox Text="{Binding GameDirectory, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="游戏目录" /></DockPanel><TextBlock Text="支持 .minecraft 根目录，也支持 versions 下的具体版本目录。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0" /></StackPanel>
            </GroupBox>
            <GroupBox Header="运行配置" Padding="0,0,0,12">
              <StackPanel IsEnabled="{Binding CanEditContent}">
                <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding MemoryLabel}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" /><TextBlock Text="最大内存" /></DockPanel>
                <Slider Minimum="1024" Maximum="32768" TickFrequency="1024" IsSnapToTickEnabled="True" Value="{Binding MemoryMb}" Margin="0,16,0,8" Foreground="{StaticResource AccentBrush}" AutomationProperties.Name="最大内存" />
                <DockPanel Margin="0,0,0,24"><TextBlock Text="1 GB" Style="{StaticResource MonoCaption}" /><TextBlock Text="32 GB" Style="{StaticResource MonoCaption}" HorizontalAlignment="Right" /></DockPanel>
                <TextBlock Text="Java 运行时" /><TextBlock Text="{Binding JavaStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" /><TextBlock Text="自动检测系统 Java，需要时下载 Mojang Runtime。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,0,0" />
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>

        <Grid x:Name="LogsView" Margin="36,30,36,24" Visibility="{Binding IsLogsPage, Converter={StaticResource BoolVisibility}}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,24"><Button DockPanel.Dock="Right" Content="清空日志" Command="{Binding ClearLogsCommand}" VerticalAlignment="Top" /><StackPanel><TextBlock Text="运行日志" Style="{StaticResource PageTitle}" /><TextBlock Text="启动、下载和游戏输出，保留最近 1000 行。" Style="{StaticResource Caption}" /></StackPanel></DockPanel>
          <Grid Grid.Row="1"><Border Style="{StaticResource Surface}" Background="#121A15" /><ListBox x:Name="LogList" ItemsSource="{Binding Logs}" Margin="16" FontFamily="{StaticResource MonoFont}" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" /></Grid>
        </Grid>
      </Grid>

      <Border Grid.Column="1" Grid.Row="2" BorderBrush="#303B31" BorderThickness="0,1,0,0" Background="#171F19">
        <Grid Margin="24,0,16,0"><Grid.RowDefinitions><RowDefinition Height="2" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <ProgressBar Grid.Row="0" Height="2" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
          <DockPanel Grid.Row="1"><Button DockPanel.Dock="Right" Content="取消操作" Command="{Binding CancelCommand}" Style="{StaticResource LinkButton}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" MinHeight="26" FontSize="11" /><Button DockPanel.Dock="Right" Content="查看日志  ↗" Tag="Logs" Click="Navigate_Click" Style="{StaticResource GhostButton}" FontSize="10" MinHeight="26" /><TextBlock Text="{Binding Status}" Foreground="#9BAA97" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>

