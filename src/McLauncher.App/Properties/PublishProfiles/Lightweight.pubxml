<Project>
  <Import Project="$(MSBuildThisFileDirectory)Standalone.pubxml" />
  <PropertyGroup>
    <SelfContained>false</SelfContained>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\artifacts\lightweight\</PublishDir>
  </PropertyGroup>
</Project>
