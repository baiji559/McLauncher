<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon />
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\overworld-sunset.png" />
    <ProjectReference Include="..\McLauncher.Core\McLauncher.Core.csproj" />
    <PortableMcSource Include="..\..\tools\portablemc\*" />
    <EmbeddedResource Include="$(BaseIntermediateOutputPath)portablemc.zip" LogicalName="McLauncher.PortableMc.zip" />
  </ItemGroup>
  <Target Name="CompressPortableMc" BeforeTargets="PrepareForBuild"
          Inputs="@(PortableMcSource)" Outputs="$(BaseIntermediateOutputPath)portablemc.zip">
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <ZipDirectory SourceDirectory="$(MSBuildProjectDirectory)\..\..\tools\portablemc"
                  DestinationFile="$(BaseIntermediateOutputPath)portablemc.zip" Overwrite="true" />
  </Target>
</Project>

