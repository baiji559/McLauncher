<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:McLauncher.App">
  <SolidColorBrush x:Key="CanvasBrush" Color="#181E1B" />
  <SolidColorBrush x:Key="PanelBrush" Color="#222A24" />
  <SolidColorBrush x:Key="TextBrush" Color="#EDF0E8" />
  <SolidColorBrush x:Key="MutedBrush" Color="#A2ABA1" />
  <SolidColorBrush x:Key="FaintBrush" Color="#737F75" />
  <SolidColorBrush x:Key="LineBrush" Color="#343E35" />
  <SolidColorBrush x:Key="AccentBrush" Color="#8BC17C" />
  <SolidColorBrush x:Key="InputBrush" Color="#2A352C" />
  <SolidColorBrush x:Key="RowHoverBrush" Color="#344438" />
  <FontFamily x:Key="BodyFont">Microsoft YaHei UI, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>
  <!-- An 8 px inset keeps the 20 px surface and 12 px row corners concentric. -->
  <CornerRadius x:Key="SurfaceRadius">20</CornerRadius>
  <CornerRadius x:Key="RowRadius">12</CornerRadius>
  <CornerRadius x:Key="ControlRadius">8</CornerRadius>
  <DropShadowEffect x:Key="SurfaceShadow" BlurRadius="24" ShadowDepth="6" Opacity="0.24" Color="#050C07" RenderingBias="Quality" />
  <DropShadowEffect x:Key="ControlShadow" BlurRadius="8" ShadowDepth="2" Opacity="0.18" Color="#050C07" RenderingBias="Quality" />
  <local:BalancedTitleConverter x:Key="BalancedTitle" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#181E1B" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#EDF0E8" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#252E27" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#EDF0E8" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#36513A" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
  <BooleanToVisibilityConverter x:Key="BoolVisibility" />
  <Geometry x:Key="CubeIcon">M 8,1 L 15,5 15,14 8,18 1,14 1,5 Z M 1,5 L 8,9 15,5 M 8,9 L 8,18</Geometry>
  <DrawingImage x:Key="GrassBlock">
    <DrawingImage.Drawing><DrawingGroup>
      <GeometryDrawing Brush="#765339" Geometry="M 3,13 L 24,24 24,47 3,36 Z" />
      <GeometryDrawing Brush="#513E2D" Geometry="M 24,24 L 45,13 45,36 24,47 Z" />
      <GeometryDrawing Brush="#80AD51" Geometry="M 3,13 L 24,2 45,13 24,24 Z" />
      <GeometryDrawing Brush="#5A923E" Geometry="M 3,13 L 24,24 24,30 18,27 18,30 13,27 13,22 8,19 8,22 3,19 Z" />
      <GeometryDrawing Brush="#477D35" Geometry="M 24,24 L 45,13 45,20 40,23 40,20 35,23 35,28 29,31 29,27 24,30 Z" />
      <GeometryDrawing Brush="#94BE61" Geometry="M 13,10 L 19,7 25,10 19,13 Z M 27,14 L 33,11 39,14 33,17 Z M 19,19 L 24,16 29,19 24,22 Z" />
      <GeometryDrawing Brush="#936B45" Geometry="M 6,25 L 11,28 11,33 6,30 Z M 15,33 L 20,36 20,42 15,39 Z M 12,24 L 16,26 16,31 12,29 Z" />
      <GeometryDrawing Brush="#6B5137" Geometry="M 28,34 L 33,31 33,36 28,39 Z M 37,27 L 42,24 42,29 37,32 Z M 35,37 L 40,34 40,38 35,41 Z" />
    </DrawingGroup></DrawingImage.Drawing>
  </DrawingImage>
  <DrawingImage x:Key="PlayerFace">
    <DrawingImage.Drawing><DrawingGroup>
      <GeometryDrawing Brush="#413125" Geometry="M 0,0 H 8 V 8 H 0 Z" />
      <GeometryDrawing Brush="#B98965" Geometry="M 1,3 H 7 V 7 H 1 Z" />
      <GeometryDrawing Brush="#D0A37C" Geometry="M 2,2 H 6 V 5 H 2 Z" />
      <GeometryDrawing Brush="#E8E7DD" Geometry="M 1,4 H 3 V 5 H 1 Z M 5,4 H 7 V 5 H 5 Z" />
      <GeometryDrawing Brush="#56618D" Geometry="M 2,4 H 3 V 5 H 2 Z M 5,4 H 6 V 5 H 5 Z" />
      <GeometryDrawing Brush="#76503A" Geometry="M 3,5 H 5 V 6 H 3 Z M 2,6 H 6 V 7 H 2 Z" />
      <GeometryDrawing Brush="#3D8C88" Geometry="M 0,7 H 2 V 8 H 0 Z M 6,7 H 8 V 8 H 6 Z" />
    </DrawingGroup></DrawingImage.Drawing>
  </DrawingImage>
  <Style TargetType="Window">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" /><Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Background" Value="{StaticResource CanvasBrush}" />
    <Setter Property="UseLayoutRounding" Value="True" /><Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>
  <Style TargetType="TextBlock"><Setter Property="Typography.NumeralAlignment" Value="Tabular" /><Setter Property="Typography.NumeralStyle" Value="Lining" /></Style>
  <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="18" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" /></Style>
  <Style x:Key="MonoCaption" TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="FontFamily" Value="{StaticResource MonoFont}" /></Style>
  <Style x:Key="BalancedTitleText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="22" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="MaxHeight" Value="44" /><Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style x:Key="Surface" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" /><Setter Property="CornerRadius" Value="{StaticResource SurfaceRadius}" />
    <Setter Property="BorderThickness" Value="0" /><Setter Property="Effect" Value="{StaticResource SurfaceShadow}" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="28" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,8" /></Style>
  <ControlTemplate x:Key="ActionButtonTemplate" TargetType="Button">
    <Grid>
      <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource ControlRadius}" Effect="{StaticResource ControlShadow}" IsHitTestVisible="False" />
      <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource ControlRadius}">
        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
      </Border>
      <Border x:Name="FocusRing" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="10" Margin="-2" Opacity="0" IsHitTestVisible="False" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Opacity" Value="1" /></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="FlatButtonTemplate" TargetType="Button">
    <Grid>
      <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource RowRadius}">
        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
      </Border>
      <Border x:Name="FocusRing" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="{StaticResource RowRadius}" Opacity="0" IsHitTestVisible="False" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Opacity" Value="1" /></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Background" Value="#2D3930" />
    <Setter Property="BorderThickness" Value="0" /><Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="16,8" /><Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource ActionButtonTemplate}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#3A493D" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#263429" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" /><Setter Property="Foreground" Value="#152511" /><Setter Property="FontWeight" Value="SemiBold" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#A1D191" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#73AB66" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}" />
    <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Setter Property="Padding" Value="12,8" />
  </Style>
  <Style x:Key="VersionRowButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
    <Setter Property="MinHeight" Value="88" /><Setter Property="Padding" Value="16,12" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Margin" Value="0" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource RowHoverBrush}" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#2C3C30" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource GhostButton}"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter Property="FontSize" Value="12" /></Style>
  <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
    <Setter Property="Width" Value="46" /><Setter Property="Height" Value="40" /><Setter Property="MinHeight" Value="0" /><Setter Property="FontFamily" Value="Segoe MDL2 Assets" /><Setter Property="FontSize" Value="10" /><Setter Property="Foreground" Value="#CAD1C8" /><Setter Property="Padding" Value="0" />
  </Style>
  <Style x:Key="NavButton" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Setter Property="Background" Value="Transparent" /><Setter Property="FontSize" Value="14" /><Setter Property="Margin" Value="12,3" /><Setter Property="Padding" Value="17,13" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Border x:Name="NavSurface" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RowRadius}"><Grid>
        <Border x:Name="Mark" Width="3" Height="18" Background="Transparent" HorizontalAlignment="Left" CornerRadius="1" />
        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
        <Border x:Name="NavFocus" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="{StaticResource RowRadius}" Opacity="0" IsHitTestVisible="False" />
      </Grid></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#222C25" /></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#2B382E" /><Setter TargetName="Mark" Property="Background" Value="{StaticResource AccentBrush}" /><Setter Property="Foreground" Value="#EFF4E9" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavFocus" Property="Opacity" Value="1" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource InputBrush}" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="12,8" /><Setter Property="MinHeight" Value="40" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="SelectionBrush" Value="#4A6A48" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Grid>
        <Border CornerRadius="{StaticResource ControlRadius}" Background="{TemplateBinding Background}" Effect="{StaticResource ControlShadow}" IsHitTestVisible="False" />
        <Border CornerRadius="{StaticResource ControlRadius}" Background="{TemplateBinding Background}"><ScrollViewer x:Name="PART_ContentHost" /></Border>
        <Border x:Name="InputFocus" CornerRadius="{StaticResource ControlRadius}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Opacity="0" IsHitTestVisible="False" />
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputFocus" Property="Opacity" Value="1" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ComboEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" /></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Background" Value="{StaticResource InputBrush}" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" /><Setter Property="Padding" Value="12,8" /><Setter Property="MinHeight" Value="40" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Grid>
      <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource ControlRadius}" Effect="{StaticResource ControlShadow}" IsHitTestVisible="False" />
      <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource ControlRadius}"><ScrollViewer x:Name="PART_ContentHost" /></Border>
      <Border x:Name="PasswordFocus" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Opacity="0" IsHitTestVisible="False" />
    </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="PasswordFocus" Property="Opacity" Value="1" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Padding" Value="10,8" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource ControlRadius}"><ContentPresenter /></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#354638" /></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#2C3D2F" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Background" Value="{StaticResource InputBrush}" /><Setter Property="MinHeight" Value="40" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid>
        <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource ControlRadius}" Effect="{StaticResource ControlShadow}" IsHitTestVisible="False" />
        <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource ControlRadius}" />
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><Path Data="M 0,0 L 4,4 8,0" Stroke="#A2ABA1" StrokeThickness="1.3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" /></Border></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter x:Name="Selection" IsHitTestVisible="False" Margin="12,8,36,8" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
        <TextBox x:Name="PART_EditableTextBox" Style="{StaticResource ComboEditor}" Visibility="Hidden" Margin="12,0,36,0" Background="Transparent" IsReadOnly="{TemplateBinding IsReadOnly}" VerticalContentAlignment="Center" />
        <Border x:Name="ComboFocus" CornerRadius="{StaticResource ControlRadius}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Opacity="0" IsHitTestVisible="False" />
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" HorizontalOffset="0" VerticalOffset="8" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
          <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="340" Margin="12,8,12,20">
            <Border Background="#253128" CornerRadius="{StaticResource RowRadius}" Effect="{StaticResource SurfaceShadow}" IsHitTestVisible="False" />
            <Border Background="#253128" CornerRadius="{StaticResource RowRadius}" Padding="4"><ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer></Border>
          </Grid>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsEditable" Value="True"><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" /><Setter TargetName="Selection" Property="Visibility" Value="Hidden" /></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboFocus" Property="Opacity" Value="1" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="GroupBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupBox"><DockPanel>
      <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12"><ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold" TextElement.FontSize="15" /></Border>
      <ContentPresenter Margin="{TemplateBinding Padding}" />
    </DockPanel></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" /></Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="8,4" /><Setter Property="Margin" Value="0,2" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource RowRadius}"><ContentPresenter /></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#27342B" /></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#304435" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="16" Height="16" BorderBrush="#71806E" BorderThickness="1" CornerRadius="2" Margin="0,0,9,0" Background="#202822"><Path x:Name="Check" Data="M 3,7 L 6,10 12,3" Stroke="#152511" StrokeThickness="2" Visibility="Collapsed" /></Border><ContentPresenter VerticalAlignment="Center" /></StackPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible" /><Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <StackPanel Orientation="Horizontal"><Grid Width="16" Height="16" Margin="0,0,9,0"><Ellipse Stroke="#7C8B76" StrokeThickness="1" /><Ellipse x:Name="Dot" Fill="{StaticResource AccentBrush}" Margin="4" Visibility="Collapsed" /></Grid><ContentPresenter VerticalAlignment="Center" /></StackPanel>
      <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Dot" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><DockPanel>
      <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Left">
        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" Padding="0,6"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Arrow" Text="›" Width="18" Foreground="{StaticResource MutedBrush}" /><ContentPresenter /></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Text" Value="⌄" /></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
        <ContentPresenter Content="{TemplateBinding Header}" />
      </ToggleButton>
      <ContentPresenter x:Name="ExpandedContent" Visibility="Collapsed" />
    </DockPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ProgressBar"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter Property="Background" Value="#2B372D" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10" /><Setter Property="MinWidth" Value="10" /><Setter Property="Background" Value="Transparent" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Grid Background="{TemplateBinding Background}">
        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
          <Track.DecreaseRepeatButton><RepeatButton x:Name="ScrollDecrease" Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb x:Name="ScrollThumb" MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#4A5A4C" CornerRadius="3" Margin="2" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton x:Name="ScrollIncrease" Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
        </Track>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto" /><Setter Property="MinWidth" Value="0" /><Setter Property="Height" Value="10" /><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" /><Setter TargetName="ScrollDecrease" Property="Command" Value="ScrollBar.PageLeftCommand" /><Setter TargetName="ScrollIncrease" Property="Command" Value="ScrollBar.PageRightCommand" /><Setter TargetName="ScrollThumb" Property="MinHeight" Value="0" /><Setter TargetName="ScrollThumb" Property="MinWidth" Value="24" /></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
      <Grid Height="22" Margin="4,0">
        <Track x:Name="PART_Track" IsDirectionReversed="{TemplateBinding IsDirectionReversed}" Orientation="Horizontal">
          <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" Background="{StaticResource AccentBrush}" CornerRadius="1" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Width="14" Height="14"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="7" Background="#D0DFC7" BorderBrush="#8BC17C" BorderThickness="2" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" Background="#3C4B3E" CornerRadius="1" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
        </Track>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="#2B372D" /><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="BorderBrush" Value="#485746" /><Setter Property="Padding" Value="10,6" /></Style>
</ResourceDictionary>

